# Lunéa environment variables — names and descriptions only.
# Never put real values here. Copy to .env (gitignored) for local use.
# Final variable set depends on backend decision (D-06) and AI provider decision (D-08).

# Runtime environment: development | staging | production
APP_ENV=

# Mobile client: public API base URL (EXPO_PUBLIC_* values are bundled into the app — never secrets)
EXPO_PUBLIC_API_BASE_URL=

# Server only: AI adapter mode. Use "mock" until provider and data terms are approved.
AI_PROVIDER=mock

# Server only: AI provider API key (unused while AI_PROVIDER=mock). Never expose to the client.
AI_PROVIDER_API_KEY=
